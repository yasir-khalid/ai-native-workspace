{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/capability-manifest.schema.json",
  "title": "CapabilityManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "owner_team", "implementation", "input_schema_ref", "result_type", "side_effect_class"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,99}$"},
    "description": {"type": "string", "maxLength": 1000},
    "owner_team": {"type": "string", "minLength": 2},
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "service_ref", "operation"],
      "properties": {
        "protocol": {"enum": ["mcp", "http", "python_internal", "workflow"]},
        "service_ref": {"type": "string", "minLength": 2},
        "operation": {"type": "string", "minLength": 1}
      }
    },
    "input_schema_ref": {"type": "string"},
    "result_type": {"enum": ["json", "artifact", "event", "none"]},
    "side_effect_class": {"enum": ["read_only", "local_artifact", "external_write", "irreversible"]},
    "requires_approval": {"type": "boolean", "default": false},
    "supports_idempotency": {"type": "boolean", "default": true},
    "default_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  }
}
