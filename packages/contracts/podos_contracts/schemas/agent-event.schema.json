{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-event.schema.json",
  "title": "AgentEvent",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_id", "pod_id", "agent_id", "run_id", "type", "classification", "recipient_user_ids", "created_at", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 8},
    "pod_id": {"type": "string", "minLength": 2},
    "agent_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 8},
    "correlation_id": {"type": "string"},
    "type": {"enum": ["research_completed", "monitor_alert", "approval_requested", "run_failed", "workflow_completed"]},
    "classification": {"enum": ["public", "internal", "pod_confidential", "restricted"]},
    "recipient_user_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "subject_resource": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"type": "string"}, "id": {"type": "string"}}, "additionalProperties": false},
    "created_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object", "additionalProperties": true}
  }
}
